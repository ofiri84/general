{
  "name": "yachad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "apps/api",
    "apps/web",
    "infra"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @yachad/api",
    "dev:web": "npm run dev -w @yachad/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @yachad/web",
    "synth": "npm run build && npm run synth -w @yachad/infra",
    "deploy": "npm run build && npm run deploy -w @yachad/infra"
  },
  "engines": {
    "node": ">=20"
  }
}
